# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=SBK TaskManager API
APP_ENV=local            # local | production
APP_URL=http://localhost:8000
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default — works out of the box):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Postgres (uncomment and swap in requirements.txt too):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sbk

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Storage ────────────────────────────────────────────────────────────────
# Files are stored under ./storage/ and served at /storage/*
STORAGE_DIR=./storage
# Max upload size per file, in bytes (5 MB default)
MAX_UPLOAD_BYTES=5242880

# ─── OneSignal (push notifications) ─────────────────────────────────────────
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-rest-api-key
# Set to "1" to actually call OneSignal in local dev; otherwise notifications
# are logged but not sent.
ONESIGNAL_ENABLED=0
